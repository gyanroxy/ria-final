LIVEKIT_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key_here"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"
OPENAI_API_KEY="your_openai_api_key_here"
SMALLEST_API_KEY="your_smallest_ai_api_key_here"

# Model & Voice Configurations
OPENAI_LLM_MODEL="gpt-4.1"
OPENAI_TEMPERATURE="0.4"
OPENAI_MAX_COMPLETION_TOKENS="300"
LLM_MAX_CONTEXT_ITEMS="12"

OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
STT_PROVIDER="openai"  # "smallest" only works in one fixed language (SMALLEST_STT_LANGUAGE)
GREETING_LANGUAGE="te"
SMALLEST_STT_LANGUAGE="te"
SMALLEST_STT_EOU_TIMEOUT_MS="1000"
SMALLEST_TTS_MODEL="lightning_v3.1_pro"
SMALLEST_TTS_VOICE_ID="mishka"
SMALLEST_TTS_LANGUAGE="auto"
SMALLEST_TTS_SAMPLE_RATE="24000"
SMALLEST_TTS_SPEED="1.15"

# Latency & Turn-Taking Optimization
ENDPOINTING_MIN_DELAY="0.5"
ENDPOINTING_MAX_DELAY="3.0"
VAD_MIN_SILENCE_DURATION="0.3"
VAD_MIN_SPEECH_DURATION="0.15"
VAD_ACTIVATION_THRESHOLD="0.6"
INTERRUPTION_MIN_DURATION="0.4"
INTERRUPTION_MIN_WORDS="0"
FALSE_INTERRUPTION_TIMEOUT="2.0"
AEC_WARMUP_DURATION="0.5"

PORT=5001
FRONTEND_ORIGIN="*"  # in production set your site, e.g. "https://your-domain.com"
