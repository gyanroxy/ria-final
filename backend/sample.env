LIVEKIT_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key_here"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"
OPENAI_API_KEY="your_openai_api_key_here"
SMALLEST_API_KEY="your_smallest_ai_api_key_here"

# Dashboard (server.py). Without a password it only opens from this machine.
PORT=5001
DASHBOARD_PASSWORD=""

# Vobiz telephony (Vobiz console > SIP Trunk > Outbound Trunks > Trunks)
VOBIZ_SIP_DOMAIN="your_unique_domain.sip.vobiz.ai"
VOBIZ_USERNAME="your_vobiz_trunk_username"
VOBIZ_PASSWORD="your_vobiz_trunk_password"
VOBIZ_PHONE_NUMBER="+91XXXXXXXXXX"  # your Vobiz number, E.164
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=""  # printed by `python setup_vobiz.py`

# Invoice calls
COLLECTION_COMPANY="Your Company Name"  # RIA says she calls on behalf of this company
COLLECTION_LANGUAGE="te"  # opening line language (te, hi or en) when the import has none
COLLECTION_CALL_HOURS="8-19"  # IST; the dialer only calls inside this window
DIALER_CONCURRENCY="1"  # calls at the same time (1 = one after another)
MAX_CALL_MINUTES="3"  # hang up longer calls (cost guard)

# How RIA talks.
#  "realtime-mishka" (default): gpt-realtime hears the call and writes the reply,
#     Smallest mishka speaks it.
#  "realtime": the OpenAI model also speaks (voice shimmer). ~1.2-1.6 s, ~₹6-9 per call.
#  "pipeline": Pulse STT -> GPT -> Smallest TTS below. 2-4.5 s per reply.
#     With LLM_PROVIDER="smallest" the call runs on Smallest AI + Vobiz only
#     (OPENAI_API_KEY not needed).
AGENT_MODE="realtime-mishka"
# OPENAI_REALTIME_MODEL="gpt-realtime"  # gpt-realtime-mini is cheaper but misread Telugu dates in tests
OPENAI_REALTIME_VOICE="shimmer"  # realtime mode only; clearest Telugu of the voices tested
OPENAI_TTS_MODEL="gpt-4o-mini-tts"  # realtime mode only: greeting in the same voice
REALTIME_SILENCE_MS="300"  # silence before RIA answers; lower is faster but can cut customers off

# Per-call cost line in the agent log (₹). Set your Vobiz plan's per-minute rate.
VOBIZ_INR_PER_MIN="0.5"
USD_INR="88"

# Pipeline mode only: models & voice
LLM_PROVIDER="openai"  # "smallest" = Smallest Electron (needs a Smallest plan with Electron; Standard allows 10 requests/min)
SMALLEST_LLM_MODEL="electron"
OPENAI_LLM_MODEL="gpt-4.1-mini"  # bigger models add a pause before every reply
OPENAI_TEMPERATURE="0.4"
OPENAI_MAX_COMPLETION_TOKENS="150"  # reply length cap for either LLM
LLM_MAX_CONTEXT_ITEMS="12"
STT_PROVIDER="smallest"  # Smallest Pulse, locked to the call language; "openai" to use the two lines below
OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
STT_SILENCE_MS="250"
SMALLEST_TTS_MODEL="lightning_v3.1_pro"  # the voice in realtime-mishka and pipeline modes
SMALLEST_TTS_VOICE_ID="mishka"
SMALLEST_TTS_LANGUAGE="auto"
SMALLEST_TTS_SAMPLE_RATE="44100"  # Lightning v3.1 is natively 44.1 kHz
SMALLEST_NUMBER_LANGUAGE="en"  # how numbers, ₹ amounts and dates are read (te, hi, en); empty = same as the voice
SMALLEST_TTS_SPEED="1.0"

# Turn-taking (response delay). Raise ENDPOINTING_MIN_DELAY if customers get cut off.
ENDPOINTING_MIN_DELAY="0.2"
ENDPOINTING_MAX_DELAY="2.5"
VAD_MIN_SILENCE_DURATION="0.25"
VAD_MIN_SPEECH_DURATION="0.15"
VAD_ACTIVATION_THRESHOLD="0.6"
INTERRUPTION_MIN_DURATION="0.4"
INTERRUPTION_MIN_WORDS="0"
FALSE_INTERRUPTION_TIMEOUT="1.5"
AEC_WARMUP_DURATION="0.5"
